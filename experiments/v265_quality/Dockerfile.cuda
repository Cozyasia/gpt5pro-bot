# Configuration only; no paid compute is started. Training needs explicit approval.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
WORKDIR /app
RUN pip install --no-cache-dir numpy==1.26.4 scipy==1.14.1 pillow==11.0.0 onnx==1.17.0 onnxruntime==1.20.1
COPY experiments /app/experiments
ENV OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 CUBLAS_WORKSPACE_CONFIG=:4096:8
ENTRYPOINT ["python", "-m", "experiments.v265_quality.train"]
