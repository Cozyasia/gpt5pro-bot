FROM python:3.12-slim
WORKDIR /app
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir numpy==1.26.4 scipy==1.14.1 pillow==11.0.0 onnx==1.17.0 onnxruntime==1.20.1
COPY experiments /app/experiments
ARG CODE_COMMIT
ENV V265_CODE_COMMIT=$CODE_COMMIT
CMD ["python", "-m", "unittest", "experiments.v265_quality.test_quality"]
