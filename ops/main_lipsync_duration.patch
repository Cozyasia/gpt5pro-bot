+def _direct_lipsync_fit_audio_sync(raw: bytes, source_duration: float, video_duration: float) -> bytes:
+    # Leave room for MP3 encoder delay and provider timestamp rounding.
+    target = video_duration - 0.35
+    if target < 2.0 or source_duration / target > 1.35:
+        raise ValueError("Речь не помещается в видео. Сократите текст или выберите более длинный ролик.")
+    with tempfile.TemporaryDirectory(prefix="neyronix_lipsync_fit_") as td:
+        src, out = os.path.join(td, "source.mp3"), os.path.join(td, "fitted.mp3")
+        with open(src, "wb") as fh:
+            fh.write(raw)
+        result = subprocess.run(
+            [_ffmpeg_exe(), "-nostdin", "-y", "-hide_banner", "-loglevel", "error", "-i", src,
+             "-filter:a", f"atempo={source_duration / target:.6f}", "-c:a", "libmp3lame", "-b:a", "128k", out],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=90,
+        )
+        if result.returncode or not os.path.isfile(out):
+            raise RuntimeError("Не удалось подогнать речь по длительности видео.")
+        with open(out, "rb") as fh:
+            fitted = fh.read()
+        actual = _direct_lipsync_duration_sync(fitted, ".mp3")
+        if actual < 2.0 or actual > video_duration - 0.10:
+            raise ValueError("Речь не помещается в видео. Сократите текст или выберите более длинный ролик.")
+        return fitted
+
