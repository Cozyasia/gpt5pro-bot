+async def _on_veo_resume_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
+    """Resume one owned native Veo job from its durable failed Extend step."""
+    q = update.callback_query
+    from pathlib import Path
+    from neyrobot_prod.veo_recovery import parse_callback_data, read_metadata, retryable_extension
+
+    job_hash = parse_callback_data(q.data or "")
+    if not job_hash:
+        await q.answer("Некорректная задача", show_alert=True)
+        return
+    root = Path(os.environ.get("VEO_JOBS_DIR", "/data/veo_jobs")).resolve()
+    directory = (root / job_hash).resolve()
+    if directory.parent != root or not directory.is_dir():
+        await q.answer("Задание не найдено", show_alert=True)
+        return
+    metadata = read_metadata(directory)
+    if int(metadata.get("owner_user_id") or -1) != int(q.from_user.id):
+        await q.answer("Эта кнопка принадлежит другому пользователю", show_alert=True)
+        return
+    if not retryable_extension(directory):
+        await q.answer("Для этого задания больше нечего продолжать", show_alert=True)
+        return
+    await q.answer("Продолжаю с сохранённого шага")
+    with contextlib.suppress(Exception):
+        await q.edit_message_reply_markup(reply_markup=None)
+    await _run_veo_extend_chain(
+        update, context, str(metadata.get("prompt") or ""), int(metadata.get("duration_seconds") or 0),
+        resume_directory=directory, resume_only=True,
+    )
